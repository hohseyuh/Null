# systemd unit for running nullapi without Docker.
#   install: cp deploy/nullapi.service /etc/systemd/system/
#   config:  systemctl edit nullapi   (override the Environment lines)
#   run:     systemctl enable --now nullapi
[Unit]
Description=Null vault API and reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nullapi
Environment=NULL_VAULT_PATH=/srv/null-vault
Environment=NULL_ADDR=127.0.0.1:8080
# Put NULL_TOKEN (and, separately, NULL_UI_TOKEN) in a root-owned file
# instead of the unit:
EnvironmentFile=/etc/nullapi/env
Restart=on-failure
RestartSec=2

# Hardening. The vault is the one place the service writes (Al-Mina's tier
# commits), so it is listed in ReadWritePaths and the user that owns the
# vault must be the one this runs as — a DynamicUser cannot commit into a
# repository it does not own. Create a dedicated user and chown the vault:
#   useradd --system null && chown -R null /srv/null-vault
User=null
ProtectSystem=strict
ReadWritePaths=/srv/null-vault
ProtectHome=true
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
