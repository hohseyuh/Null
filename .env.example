# Copy to .env and fill in. `.env` is git-ignored — never commit it.
# Generate secrets with:  openssl rand -hex 32

# --- compose.yaml -------------------------------------------------------
# Token for the JSON API.
NULL_TOKEN=
# Separate token for the browser UI, Al-Mina and /setup. Set it whenever any
# program or model holds NULL_TOKEN.
NULL_UI_TOKEN=
# Host directory holding your vault (must be a git repository).
VAULT_PATH=/srv/null-vault

# Persist nullmcp's OAuth clients/tokens across restarts (path inside the container;
# mount a volume there). Leave unset to keep them in memory.
# NULL_MCP_STATE_PATH=/state/oauth.json

# nullmcp (remote MCP over HTTPS) — its own credential, distinct from the two above.
NULL_MCP_TOKEN=
# The public https origin your reverse proxy exposes nullmcp on.
NULL_MCP_PUBLIC_URL=https://your-host.example

# --- compose.setup.yaml (choose the vault in the browser) ----------------
# Parent directory of your vault(s); /setup can only browse inside it.
# VAULTS_DIR=/srv/vaults

# The container user needs write access to the vault (git commits). Default is
# the image's own uid; set these to your ids if the vault is owned by you.
# NULL_UID=1000
# NULL_GID=1000
